# URL Google Apps Script (action=getLastSensor). Wajib.
SENSOR_API_URL=https://script.google.com/macros/s/GANTI_DEPLOYMENT_ID/exec?action=getLastSensor

# Timeout permintaan ke API sensor, dalam milidetik (500-30000). Opsional, default 8000.
SENSOR_TIMEOUT_MS=8000

# Hanya untuk bridge Xiaozhi (proses panjang, BUKAN Vercel).
# Salin dari Xiaozhi Console > Agent > Konfigurasi > MCP Endpoint. Isinya mengandung token rahasia.
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjExMjUwNjksImFnZW50SWQiOjI1MjU3NTIsImVuZHBvaW50SWQiOiJhZ2VudF8yNTI1NzUyIiwicHVycG9zZSI6Im1jcC1lbmRwb2ludCIsImlhdCI6MTc5MjQ4NDM0NywiZXhwIjoxODI0MDQxOTQ3fQ.ZedPBuvBB0SxgNPe63eUx_J8l0TIJmjZOAldStxyV4ixq1ouKUt70ymyop-IJhlu6h12-VUC89uclSVg_N4_6w

# Opsional. Jika diatur, bridge membuka GET /health pada port ini (untuk Render Web Service
# dan pemantau uptime). Render mengisinya otomatis; biarkan kosong di Railway/VPS/mesin sendiri.
PORT=

# Hanya untuk endpoint HTTP MCP di Vercel. Buat string acak panjang, mis.: openssl rand -hex 32
# Jika kosong, endpoint /api/mcp menolak semua request.
MCP_AUTH_TOKEN=
